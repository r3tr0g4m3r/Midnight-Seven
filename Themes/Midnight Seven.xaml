<ToolTip x:Key="StartButtonTip" Content="{DynamicResource start_button_tip}" />

    <Style x:Key="StartButton" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ItemButtonForeground}" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="StartButtonBorder1"
                        Margin="0"
                        Background="{DynamicResource TaskbarBackground}"
                        BorderBrush="{DynamicResource StartButtonBorder1}"
                        BorderThickness="0,1,0,0">
                        <Border
                            x:Name="StartButtonBorder2"
                            BorderBrush="{DynamicResource StartButtonBorder2}"
                            BorderThickness="1,0,0,0">
                            <Border
                                x:Name="StartButtonBorder3"
                                BorderBrush="Transparent"
                                BorderThickness="0,1,1,0">
                                <Grid x:Name="StartButtonContent">
                                    <Canvas x:Name="BlurBehind" Margin="4,2">
                                        <Canvas.Effect>
                                            <BlurEffect Radius="12" />
                                        </Canvas.Effect>
                                    </Canvas>
                                    <Border
                                        x:Name="StartSheen"
                                        Background="{DynamicResource GlassCornerSheen}" />
                                    <Border
                                        Height="1"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource GlassEdgeLight}" />
                                    <Border
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource GlassEdgeLight}" />
                                    <Border
                                        Width="1"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource GlassEdgeLight}" />
                                    <Border
                                        Width="1"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource GlassEdgeLight}" />
                                    <Image x:Name="StartIcon"
                                           Width="{DynamicResource StartButtonIconSize}"
                                           Height="{DynamicResource StartButtonIconSize}"
                                           Source="{DynamicResource StartButtonIcon}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                            <Setter TargetName="StartButtonBorder2" Property="BorderThickness" Value="0" />
                            <Setter TargetName="StartButtonContent" Property="Margin" Value="0" />
                            <Setter Property="Width" Value="{DynamicResource TaskbarWidth}" />
                            <Setter Property="Height" Value="{DynamicResource StartButtonVerticalSize}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Horizontal">
                            <Setter Property="Width" Value="{DynamicResource TaskbarWidth}" />
                            <Setter Property="Height" Value="{DynamicResource TaskbarHeight}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BlurBehind" Property="Background" Value="#484896" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="StartButtonBorder1" Property="BorderBrush" Value="{DynamicResource StartButtonBorder1Pressed}" />
                            <Setter TargetName="StartButtonBorder1" Property="BorderThickness" Value="0,1,1,0" />
                            <Setter TargetName="StartButtonBorder3" Property="BorderBrush" Value="{DynamicResource StartButtonBorder3}" />
                            <Setter TargetName="StartButtonContent" Property="Margin" Value="0,0,1,0" />
                            <Setter TargetName="BlurBehind" Property="Margin" Value="4,2,2,2" />
                            <Setter TargetName="BlurBehind" Property="Background" Value="#484896" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StartButtonBorder1" Property="BorderBrush" Value="{DynamicResource StartButtonBorder1Pressed}" />
                            <Setter TargetName="StartButtonBorder1" Property="BorderThickness" Value="0,1,1,0" />
                            <Setter TargetName="StartButtonBorder3" Property="BorderBrush" Value="{DynamicResource StartButtonBorder3}" />
                            <Setter TargetName="StartButtonContent" Property="Margin" Value="0,0,1,0" />
                            <Setter TargetName="BlurBehind" Property="Margin" Value="4,2,2,2" />
                            <Setter TargetName="BlurBehind" Property="Background" Value="#484896" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                <DataTrigger.Setters>
                    <Setter Property="Margin" Value="0" />
                </DataTrigger.Setters>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="TaskIcon"
        BasedOn="{StaticResource SystemTheme.TaskIcon}"
        TargetType="Image">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Hide window title text on task buttons: icon-only buttons like Win7/10 -->
    <Style
        x:Key="TaskLabel"
        BasedOn="{StaticResource SystemTheme.TaskLabel}"
        TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style
        x:Key="StartIcon"
        BasedOn="{StaticResource SystemTheme.StartIcon}"
        TargetType="Image">
        <Setter Property="Width" Value="{DynamicResource StartButtonIconSize}" />
        <Setter Property="Height" Value="{DynamicResource StartButtonIconSize}" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Source" Value="{DynamicResource StartButtonIcon}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
