    <!-- Show desktop button: Win7-style 15px blank sliver at the end of the bar.
         Midnight purple grading; separator line faces the tray (left edge when
         horizontal, top edge when vertical); width/height switch per orientation. -->
    <LinearGradientBrush x:Key="ShowDesktopBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#1d1230" />
        <GradientStop Offset="1.0" Color="#16111f" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShowDesktopHover" Color="#303063" />
    <SolidColorBrush x:Key="ShowDesktopPressed" Color="#484896" />
    <SolidColorBrush x:Key="ShowDesktopSeparator" Color="#433357" />
    <!-- Directional end-glow sheen: strong shine at the leading end, fast fade,
         one unified rounded 12% black band (5-stop ramp, neutral transparent
         gaps — no contour lines), faint glint at the far end.
         Vertical-axis for the horizontal bar (bright top), rotated axis for the
         vertical bar (bright left). -->
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#40FFFFFF" />
        <GradientStop Offset="0.12" Color="#14FFFFFF" />
        <GradientStop Offset="0.35" Color="#00000000" />
        <GradientStop Offset="0.45" Color="#0A000000" />
        <GradientStop Offset="0.55" Color="#1F000000" />
        <GradientStop Offset="0.65" Color="#0A000000" />
        <GradientStop Offset="0.75" Color="#00000000" />
        <GradientStop Offset="0.9" Color="#0CFFFFFF" />
        <GradientStop Offset="1.0" Color="#1AFFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheenRotated" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#40FFFFFF" />
        <GradientStop Offset="0.12" Color="#14FFFFFF" />
        <GradientStop Offset="0.35" Color="#00000000" />
        <GradientStop Offset="0.45" Color="#0A000000" />
        <GradientStop Offset="0.55" Color="#1F000000" />
        <GradientStop Offset="0.65" Color="#0A000000" />
        <GradientStop Offset="0.75" Color="#00000000" />
        <GradientStop Offset="0.9" Color="#0CFFFFFF" />
        <GradientStop Offset="1.0" Color="#1AFFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassEdgeLight" Color="#4DFFFFFF" />
    <!-- Start button: light only the opposite corners (TL -> BR) for a subtle 3D
         orb effect; no full-width band, no dark band. -->
    <LinearGradientBrush x:Key="GlassCornerSheen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#40FFFFFF" />
        <GradientStop Offset="0.15" Color="#0CFFFFFF" />
        <GradientStop Offset="0.32" Color="#00000000" />
        <GradientStop Offset="0.68" Color="#00000000" />
        <GradientStop Offset="0.85" Color="#0CFFFFFF" />
        <GradientStop Offset="1.0" Color="#33FFFFFF" />
    </LinearGradientBrush>

    <!-- Show desktop sliver: triangular glass facets (soft sheen, bright at base).
         Horizontal: isosceles triangle on top edge (80% width, 20% height, apex down).
         Vertical: isosceles triangle on left edge (70% height, 15% width, apex right).
         Soft glass sheen gradient (smooth transitions, subtle dark band, far glint). -->
    <!-- Show desktop sliver: triangular glass facets (soft sheen, bright at base).
         Horizontal: isosceles triangle on top edge (80% width, 20% height, apex down).
         Vertical: isosceles triangle on left edge (70% height, 15% width, apex right).
         Soft glass sheen gradient (smooth transitions, subtle dark band, far glint). -->
    <LinearGradientBrush x:Key="GlassFacetGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.00" Color="#80FFFFFF" />
        <GradientStop Offset="0.20" Color="#40FFFFFF" />
        <GradientStop Offset="0.40" Color="#10FFFFFF" />
        <GradientStop Offset="0.50" Color="#00000000" />
        <GradientStop Offset="0.60" Color="#05000000" />
        <GradientStop Offset="0.70" Color="#00000000" />
        <GradientStop Offset="0.90" Color="#08FFFFFF" />
        <GradientStop Offset="1.00" Color="#10FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFacetGradientRotated" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.00" Color="#80FFFFFF" />
        <GradientStop Offset="0.20" Color="#40FFFFFF" />
        <GradientStop Offset="0.40" Color="#10FFFFFF" />
        <GradientStop Offset="0.50" Color="#00000000" />
        <GradientStop Offset="0.60" Color="#05000000" />
        <GradientStop Offset="0.70" Color="#00000000" />
        <GradientStop Offset="0.90" Color="#08FFFFFF" />
        <GradientStop Offset="1.00" Color="#10FFFFFF" />
    </LinearGradientBrush>

    <Style x:Key="ShowDesktopButton" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{DynamicResource ShowDesktopBackground}">
                        <Grid>
                            <Border
                                x:Name="Sheen"
                                Background="{DynamicResource GlassSheen}" />
                            <Border
                                x:Name="TopLight"
                                Height="1"
                                VerticalAlignment="Top"
                                Background="{DynamicResource GlassEdgeLight}" />
                            <Border
                                x:Name="BottomLight"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource GlassEdgeLight}" />
                            <Border
                                x:Name="LeftLight"
                                Width="1"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Background="{DynamicResource GlassEdgeLight}" />
                            <Border
                                x:Name="RightLight"
                                Width="1"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                Background="{DynamicResource GlassEdgeLight}" />
                            <Border
                                x:Name="Separator"
                                BorderBrush="{DynamicResource ShowDesktopSeparator}"
                                BorderThickness="0" />
                            <!-- Triangular glass facet (swapped by orientation) -->
                            <Path
                                x:Name="FacetShine"
                                Fill="{DynamicResource GlassFacetGradient}"
                                Data="M 0.1,0 L 0.9,0 L 0.5,0.2 Z"
                                Stretch="Fill" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Horizontal">
                            <Setter TargetName="Separator" Property="BorderThickness" Value="1,0,0,0" />
                            <Setter TargetName="FacetShine" Property="Data" Value="M 0.1,0 L 0.9,0 L 0.5,0.2 Z" />
                            <Setter TargetName="FacetShine" Property="Fill" Value="{DynamicResource GlassFacetGradient}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                            <Setter TargetName="Separator" Property="BorderThickness" Value="0,1,0,0" />
                            <Setter TargetName="Sheen" Property="Background" Value="{DynamicResource GlassSheenRotated}" />
                            <Setter TargetName="TopLight" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BottomLight" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LeftLight" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RightLight" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FacetShine" Property="Data" Value="M 0,0.15 L 0.15,0.5 L 0,0.85 Z" />
                            <Setter TargetName="FacetShine" Property="Fill" Value="{DynamicResource GlassFacetGradientRotated}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ShowDesktopHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ShowDesktopPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Horizontal">
                <Setter Property="Width" Value="15" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                <Setter Property="Height" Value="15" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ToolbarThumb"
        BasedOn="{StaticResource SystemTheme.ToolbarThumb}"
        TargetType="Thumb">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Margin" Value="4,2,4,2" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Rectangle x:Name="ThumbRect">
                            <Rectangle.Fill>
                                <DrawingBrush
                                    TileMode="Tile"
                                    Viewbox="0,0,6,6"
                                    ViewboxUnits="Absolute"
                                    Viewport="0,0,6,6"
                                    ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="{DynamicResource ToolbarThumbBackground}" Geometry="M 1 1 L 1 3 L 3 3 L 3 1 z" />
                                            <GeometryDrawing Brush="{DynamicResource ToolbarThumbForeground}" Geometry="M 0 0 L 0 2 L 2 2 L 2 0 z" />
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=Orientation}" Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter Property="Height" Value="6" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="ThumbRect" Property="Fill">
                                    <Setter.Value>
                                        <DrawingBrush
                                            TileMode="Tile"
                                            Viewbox="0,0,6,6"
                                            ViewboxUnits="Absolute"
                                            Viewport="0,0,6,6"
                                            ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="{DynamicResource ToolbarThumbBackground}" Geometry="M 0 4 L 0 6 L 2 6 L 2 4 z" />
                                                    <GeometryDrawing Brush="{DynamicResource ToolbarThumbForeground}" Geometry="M 1 3 L 1 5 L 3 5 L 3 3 z" />
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                <Setter Property="Margin" Value="5,3,6,1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TaskButtonThumbnail" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border
                        Margin="4"
                        Padding="4"
                        Background="{DynamicResource ToolTipBackground}"
                        BorderBrush="{DynamicResource ToolTipForeground}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="TaskListScrollUpButton"
        BasedOn="{StaticResource TaskListScrollButton}"
        TargetType="RepeatButton">
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource TaskListScrollButtonBackground}">
                        <Border
                            x:Name="ButtonBorder1"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1,0,0,1"
                            CornerRadius="2">
                            <Border
                                x:Name="ButtonBorder2"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="1">
                                <Border
                                    x:Name="ButtonBorder3"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1">

                                    <Border
                                        x:Name="UpArrow"
                                        Padding="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource VArrowUp}"
