    <Style x:Key="Tray" TargetType="GroupBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Name="TrayOuterBorder"
                        Margin="3,0,0,-1"
                        BorderThickness="0,1">
                        <Border
                            Name="TrayInnerBorder1"
                            Background="{DynamicResource TrayBackground}"
                            BorderBrush="{DynamicResource TrayLeftBorder1}"
                            BorderThickness="1,0,0,0">
                            <Border
                                Name="TrayInnerBorder2"
                                Padding="7,0,0,0"
                                BorderBrush="{DynamicResource TrayLeftBorder2}"
                                BorderThickness="1,0,0,0">
                                <ContentPresenter Name="Content" Margin="0,0,6,0" />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="TrayOuterBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="TrayOuterBorder" Property="Margin" Value="0" />
                                <Setter TargetName="TrayInnerBorder1" Property="BorderThickness" Value="0,1,0,0" />
                                <Setter TargetName="TrayInnerBorder2" Property="BorderThickness" Value="0,1,0,0" />
                                <Setter TargetName="TrayInnerBorder2" Property="Padding" Value="0,7,0,0" />
                                <Setter TargetName="Content" Property="Margin" Value="0,0,0,6" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Horizontal taskbar tray: 2-row width ladder. The icon list always wraps into
         exactly 2 balanced rows; the width cap steps with the icon count
         (cap = 18px pitch x ceil(count/2)) so the block grows HORIZONTALLY as icons
         appear instead of stacking rows into the 64px bar where they would clip:
         count 0-6 = 54px (3+2/3+3), 7-8 = 72 (4+4), 9-10 = 90 (5+5), 11-12 = 108 (6+6)
         ... up to 23-24 = 216. Same cap in collapsed and expanded state, and no toggle
         binding, so pressing ^ never shifts the block or moves icons. MaxHeight=40 +
         ClipToBounds is the hard guard: past 24 icons extra rows stay clipped instead
         of overflowing the fixed-height bar. Vertical mode is untouched (its content
         width is below all step caps, so no cap ever binds there). -->
    <Style x:Key="NotifyIconItems" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Horizontal">
                <Setter Property="MaxWidth" Value="54" />
                <Setter Property="MaxHeight" Value="40" />
                <Setter Property="ClipToBounds" Value="True" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="7">
                <Setter Property="MaxWidth" Value="72" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="8">
                <Setter Property="MaxWidth" Value="72" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="9">
                <Setter Property="MaxWidth" Value="90" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="10">
                <Setter Property="MaxWidth" Value="90" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="11">
                <Setter Property="MaxWidth" Value="108" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="12">
                <Setter Property="MaxWidth" Value="108" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="13">
                <Setter Property="MaxWidth" Value="126" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="14">
                <Setter Property="MaxWidth" Value="126" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="15">
                <Setter Property="MaxWidth" Value="144" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="16">
                <Setter Property="MaxWidth" Value="144" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="17">
                <Setter Property="MaxWidth" Value="162" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="18">
                <Setter Property="MaxWidth" Value="162" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="19">
                <Setter Property="MaxWidth" Value="180" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="20">
                <Setter Property="MaxWidth" Value="180" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="21">
                <Setter Property="MaxWidth" Value="198" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="22">
                <Setter Property="MaxWidth" Value="198" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="23">
                <Setter Property="MaxWidth" Value="216" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Self}}" Value="24">
                <Setter Property="MaxWidth" Value="216" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="TaskButton"
        BasedOn="{StaticResource SystemTheme.TaskButton}"
        TargetType="Button">
        <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="TaskButtonBorder1"
                        Background="{DynamicResource ButtonBackground}"
                        BorderBrush="{DynamicResource ButtonBorder1}"
                        BorderThickness="6,2,6,2"
                        CornerRadius="8,8,8,8">
                        <Border
                            x:Name="TaskButtonBorder2"
                            BorderBrush="{DynamicResource ButtonBorder2}"
                            BorderThickness="0"
                            CornerRadius="8,8,8,8">
                            <Border
                                x:Name="TaskButtonBorder3"
                                BorderBrush="{DynamicResource ButtonBorder3}"
                                BorderThickness="1"
                                CornerRadius="8,8,8,8">
                                <Grid x:Name="ButtonContent">
                                    <Canvas
                                        x:Name="BlurBehind"
                                        Grid.ColumnSpan="2"
                                        Margin="4,2">
                                        <Canvas.Effect>
                                            <BlurEffect Radius="12" />
                                        </Canvas.Effect>
                                    </Canvas>
                                    <ContentPresenter x:Name="Content" HorizontalAlignment="Center" Margin="8,8" />
                                </Grid>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!--<Setter TargetName="TaskButtonBorder1" Property="Background" Value="Transparent"/>-->
							<!--Button Hover Background Blur-->
                            <Setter TargetName="BlurBehind" Property="Background" Value="#303063" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <!--<Setter TargetName="TaskButtonBorder1" Property="Background" Value="Transparent"/>-->
                            <Setter TargetName="TaskButtonBorder1" Property="BorderBrush" Value="{DynamicResource ButtonBorder1Pressed}" />
                            <Setter TargetName="TaskButtonBorder1" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter TargetName="TaskButtonBorder2" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter TargetName="TaskButtonBorder3" Property="CornerRadius" Value="1,1,0,0" />
                            <Setter TargetName="BlurBehind" Property="Background" Value="#42428a" />
                            <Setter TargetName="ButtonContent" Property="Margin" Value="-1,-2,-1,0" />
                        </Trigger>
                        <!-- Vertical taskbar: full rounded frame, no edge-anchored pressed offset -->
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="TaskButtonBorder1" Property="BorderThickness" Value="2,2,2,2" />
                                <Setter TargetName="TaskButtonBorder2" Property="BorderThickness" Value="0" />
                                <Setter TargetName="TaskButtonBorder3" Property="CornerRadius" Value="8" />
                                <Setter TargetName="ButtonContent" Property="Margin" Value="0" />
                                <Setter TargetName="Content" Property="Margin" Value="0" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                        <!-- Horizontal taskbar: square buttons (46x46), centered vertically in 64px bar -->
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Horizontal">
                            <DataTrigger.Setters>
                                <Setter TargetName="TaskButtonBorder1" Property="BorderThickness" Value="2,2,2,2" />
                                <Setter TargetName="ButtonContent" Property="Margin" Value="0" />
                                <Setter TargetName="Content" Property="Margin" Value="0" />
                                <Setter TargetName="Content" Property="VerticalAlignment" Value="Center" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Horizontal taskbar: 64x50 tile, centered vertically in the 64px bar (7px top/bottom) -->
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Horizontal">
                <Setter Property="Width" Value="{DynamicResource TaskButtonWidth}" />
                <Setter Property="Height" Value="50" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="{DynamicResource TaskButtonMargin}" />
            </DataTrigger>
            <!-- Vertical taskbar: same 64x50 tile as horizontal, full bar width edge-to-edge -->
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                <Setter Property="Width" Value="{DynamicResource TaskButtonWidth}" />
                <Setter Property="Height" Value="50" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="{DynamicResource TaskButtonVerticalMargin}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="TaskButtonActive"
        BasedOn="{StaticResource TaskButton}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ButtonActiveForeground}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
