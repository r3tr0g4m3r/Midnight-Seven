                                <Grid x:Name="ButtonContent" Margin="-1,-2,-1,0">
                                    <Canvas
                                        x:Name="BlurBehind"
                                        Grid.ColumnSpan="2"
                                        Margin="4,2">
                                        <Canvas.Effect>
                                            <BlurEffect Radius="12" />
                                        </Canvas.Effect>
                                    </Canvas>
                                    <ContentPresenter x:Name="Content" HorizontalAlignment="Center" Margin="8,8" />
