                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="OuterBorder1" Property="BorderThickness" Value="0,1,0,0" />
                                <Setter TargetName="OuterBorder2" Property="BorderThickness" Value="0,1,0,0" />
                                <Setter TargetName="OuterNub" Property="Margin" Value="2,2,2,0" />
                                <Setter TargetName="OuterNub" Property="Height" Value="3" />
                                <Setter TargetName="OuterNub" Property="HorizontalAlignment" Value="Stretch" />
                                <Setter TargetName="OuterNub" Property="Width" Value="Auto" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsLocked, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Vertical">
                <Setter Property="Margin" Value="2,1,2,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
