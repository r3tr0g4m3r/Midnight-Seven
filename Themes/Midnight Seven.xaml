                            <Setter TargetName="ButtonBorder2" Property="BorderBrush" Value="{DynamicResource TaskListScrollButtonBorder2Hover}" />
                            <Setter TargetName="ButtonBorder3" Property="BorderBrush" Value="{DynamicResource TaskListScrollButtonBorder3Hover}" />
