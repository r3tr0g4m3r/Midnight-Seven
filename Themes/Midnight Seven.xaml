                 No Width: RetroBar sizes each button's outer box per row (shrinks it when crowded);
                 a fixed 64px tile would overflow that box and overlap neighbors. TaskButtonMargin's
                 left/right values keep the 3px gap at every size. -->
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Horizontal">
                <Setter Property="Height" Value="{DynamicResource TaskbarHeight}" />
                <Setter Property="VerticalAlignment" Value="Center" />
