                                <Condition Binding="{Binding Path=AppBarEdge, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" Value="Left" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter TargetName="TaskbarUnlockedBorder1" Property="BorderThickness" Value="0,0,1,0" />
                                <Setter TargetName="TaskbarUnlockedBorder2" Property="BorderThickness" Value="0,0,1,0" />
                                <Setter TargetName="TaskbarUnlockedBorder3" Property="BorderThickness" Value="0,0,1,0" />
                                <Setter TargetName="TaskbarUnlockedBorder4" Property="BorderThickness" Value="0,0,1,0" />
