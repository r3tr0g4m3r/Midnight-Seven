                            <Setter TargetName="ButtonBorder1" Property="BorderBrush" Value="{DynamicResource TaskListScrollButtonBorder1Hover}" />
                            <Setter TargetName="ButtonBorder2" Property="BorderBrush" Value="{DynamicResource TaskListScrollButtonBorder2Hover}" />
                            <Setter TargetName="ButtonBorder3" Property="BorderBrush" Value="{DynamicResource TaskListScrollButtonBorder3Hover}" />
                            <Setter TargetName="UpArrow" Property="Background" Value="{DynamicResource VArrowUpHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder1" Property="Background" Value="{DynamicResource TaskListScrollButtonBackgroundPressed}" />
                            <Setter TargetName="ButtonBorder1" Property="BorderBrush" Value="{DynamicResource TaskListScrollButtonBorder1Pressed}" />
                            <Setter TargetName="ButtonBorder2" Property="BorderBrush" Value="{DynamicResource TaskListScrollButtonBorder2Pressed}" />
                            <Setter TargetName="ButtonBorder3" Property="BorderBrush" Value="{DynamicResource TaskListScrollButtonBorder3Pressed}" />
                            <Setter TargetName="UpArrow" Property="Background" Value="{DynamicResource VArrowUpPressed}" />
