    <!-- Interchangeable Start button icon -->
    <!-- 
         CUSTOMIZATION GUIDE:
         =====================
         Replace this entire <DrawingImage x:Key="StartButtonIcon"> block with ONE of:
         
         1. CUSTOM PNG/JPG/BMP/TIFF/ICO (recommended for custom logos):
            <BitmapImage x:Key="StartButtonIcon" 
                         UriSource="../Resources/my-start-icon.png" 
                         DecodePixelWidth="36" DecodePixelHeight="36" />
            * Supported formats: PNG (with transparency), JPG, BMP, TIFF, ICO
            * Place your image in RetroBar's Resources folder or same folder as theme
            * Use DecodePixelWidth/Height matching StartButtonIconSize (36) for crisp rendering
            * Recommended source size: 36x36 or 48x48 (will scale down cleanly)
         
         2. CUSTOM VECTOR (DrawingImage) - scales perfectly at any size:
            <DrawingImage x:Key="StartButtonIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        * Your GeometryDrawing elements here 
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            * Use DrawingBrush/DrawingImage format (same as this default)
            * Define geometry with GeometryDrawing elements
            * Advantage: perfectly crisp at any DPI/scale
         
         3. CUSTOM DRAWINGBRUSH (if you prefer brush-based):
            <DrawingBrush x:Key="StartButtonIcon" Stretch="Uniform">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        * Your GeometryDrawing elements here 
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            * Works with Image.Source via implicit conversion
            * Stretch="Uniform" ensures proper scaling
         
         SIZING:
         +++++++
         * The icon renders at StartButtonIconSize (default 36px)
         * In vertical taskbar: button is 44px tall, icon centered
         * In horizontal taskbar: button is 34px tall, icon centered
         * For custom images, provide at least 36x36; 48x48 or 64x64 works well
         * Vector sources scale infinitely; raster sources should match or exceed 36px
         
         PLACEMENT:
         ++++++++++
         * For BitmapImage: place image in %LOCALAPPDATA%\RetroBar\Resources\ 
           or alongside this theme file, then use relative path: 
           UriSource="../Resources/my-icon.png"
         * For embedded resources in a compiled theme: use pack URI syntax
     -->
    <DrawingImage x:Key="StartButtonIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing Brush="#f57b3c" Geometry="F1 M 1.72485,5.83789L 3.1958,0.636841C 6.17462,-0.627686 7.60321,0.0866699 8.89423,0.986084L 7.42853,6.17651C 6.13751,5.28235 4.51324,4.95435 1.72485,5.83789 Z " />
                    <GeometryDrawing Brush="#1d8acb" Geometry="F1 M 0,11.949L 1.47089,6.74268C 4.44971,5.4834 5.87836,6.19775 7.16937,7.0918L 5.70367,12.2823C 4.41266,11.3936 2.97882,11.1978 0,11.949 Z " />
                    <GeometryDrawing Brush="#fecc09" Geometry="F1 M 6.47089,12.8274L 7.93652,7.63684C 9.22754,8.52563 11.2963,9.25061 14.2751,7.98608L 12.8042,13.187C 11.6614,13.6738 10.6508,13.8643 9.76715,13.8643C 8.34918,13.8643 7.26459,13.3777 6.47089,12.8274 Z " />
                    <GeometryDrawing Brush="#6dc068" Geometry="F1 M 8.1958,6.71631L 9.66138,1.52563C 10.9524,2.41992 13.0212,3.14478 16,1.88025L 14.5291,7.0813C 13.3862,7.56812 12.3757,7.75854 11.492,7.75854C 10.074,7.75854 8.98944,7.26648 8.1958,6.71631 Z " />
                </DrawingGroup.Children>
