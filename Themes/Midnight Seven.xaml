                <Setter Property="Height" Value="50" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="{DynamicResource TaskButtonVerticalMargin}" />
            </DataTrigger>
        </Style.Triggers>
