<!-- Midnight Seven - based on "Midnight Test" (Midnight Windows Longhorn by Ward Hale). Windows 7-style icon-only taskbar with large centered icons, optimized for vertical (left/right docked) taskbars. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:Double x:Key="TaskbarHeight">60</system:Double>
    <system:Double x:Key="TaskbarRowHeight">60</system:Double>
    <system:Double x:Key="TaskbarWidth">64</system:Double>
    <system:Double x:Key="TaskButtonWidth">64</system:Double>
    <!-- Floor RetroBar uses to stop shrinking horizontal task tiles and switch to
         wrapped/scrolling buttons instead (read by TaskList.SetStyles at load). -->
    <system:Double x:Key="TaskButtonMinWidth">45</system:Double>
    <system:Double x:Key="TaskbarUnlockedSize">4</system:Double>
    <system:Boolean x:Key="AllowsTransparency">True</system:Boolean>
    <system:Boolean x:Key="UseLargeIcons">True</system:Boolean>
    <!--system:Boolean x:Key="UseFloatingStartButton">false</system:Boolean-->
    <Thickness x:Key="TaskButtonMargin">1,0,2,0</Thickness>
    <Thickness x:Key="TaskButtonVerticalMargin">0,0,0,3</Thickness>

    <!-- Start button sizing (larger than task icons) -->
    <system:Double x:Key="StartButtonIconSize">36</system:Double>
    <system:Double x:Key="StartButtonVerticalSize">44</system:Double>

